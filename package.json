{
  "name": "kintsugi",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/pi-ai": "1.4.0",
      "@earendil-works/pi-coding-agent": "1.4.0",
      "@gespenst/core": "0.2.0",
      "@earendil-works/pi-durable": "1.4.0",
      "@earendil-works/pi-codemode": "1.4.0",
      "@earendil-works/chord": "1.4.0"
    }
  },
  "scripts": {
    "generate:workspace-modules": "bun run --cwd apps/web scripts/generate-workspace-modules.ts",
    "release": "bun run scripts/release.ts",
    "image:ensure-workspace": "bun scripts/ensure-workspace-image.ts",
    "test:workspace": "bun packages/workspace-image/scripts/integration.ts",
    "image:build": "bun run scripts/build-kintsugi-image.ts",
    "image:publish": "bun run scripts/build-kintsugi-image.ts --push --platform linux/amd64,linux/arm64",
    "check": "bun run generate:workspace-modules && bun run lint && bunx tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "test": "bun run generate:workspace-modules && bun run test:parallel && bun run test:native",
    "test:gateway": "bun run packages/proxy-ingress/scripts/test-workspace-gateway.ts",
    "ci": "bun ci && bun run check && bun run test",
    "web": "bun run --cwd apps/web dev",
    "preview:redesign": "bun run scripts/run-redesign-preview.ts",
    "kill": "bun run --cwd apps/web kill",
    "list": "bun run --cwd apps/web list",
    "demo:recording": "bun apps/web/demo/recording/example.ts",
    "test:parallel": "bun test --parallel=2 --parallel-delay=0 --path-ignore-patterns '**/*.helper.test.ts' --path-ignore-patterns '**/kintsugi-recording.test.ts'",
    "test:native": "bun test apps/web/test/kintsugi-recording.test.ts packages/observable-terminal/test/server/terminal-process.helper.test.ts packages/workspace-helper/test/authentication.helper.test.ts packages/workspace-helper/test/stat-files.helper.test.ts"
  },
  "devDependencies": {
    "@kintsugi/workspace-image": "workspace:*",
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.64.1",
    "bun-types": "1.4.4",
    "oxlint": "1.90.0",
    "typebox": "^1.0.57",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@pierre/diffs@1.6.2": "patches/@pierre%2Fdiffs@1.6.2.patch",
    "@gespenst/core@0.2.0": "patches/@gespenst%2Fcore@0.2.0.patch",
    "@hotwired/turbo@8.0.23": "patches/@hotwired%2Fturbo@8.0.23.patch"
  }
}
