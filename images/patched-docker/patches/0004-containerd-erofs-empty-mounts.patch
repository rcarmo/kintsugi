+	// When every mount was handled, return a bind mount to the filesystem root.
+	if firstSystemMount == len(mounts) && firstSystemMount > 0 {
 		mounts = append(mounts, mount.Mount{
 			Type:    "bind",
 			Source:  mounted[firstSystemMount-1].MountPoint,
