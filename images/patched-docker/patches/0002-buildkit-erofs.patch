@@ -0,0 +1,33 @@
+package containerimage
+
+import (
+	"context"
+
+	"github.com/containerd/containerd/v2/core/content"
+	"github.com/containerd/containerd/v2/core/diff"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/errdefs"
+	"github.com/moby/buildkit/util/contentutil"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+// fetchOnApply materializes blobs only when ApplyLayers actually needs to
+// extract a missing snapshot. Cached parents must not trigger an Unlazy of
+// the entire image simply to register its newly built layers.
+type fetchOnApply struct {
+	diff.Applier
+	store    content.Store
+	provider content.Provider
+}
+
+func (a fetchOnApply) Apply(ctx context.Context, desc ocispec.Descriptor, mounts []mount.Mount, opts ...diff.ApplyOpt) (ocispec.Descriptor, error) {
+	if _, err := a.store.Info(ctx, desc.Digest); err != nil {
+		if !errdefs.IsNotFound(err) {
+			return ocispec.Descriptor{}, err
+		}
+		if err := contentutil.Copy(ctx, a.store, a.provider, desc, "export-unpack-"+desc.Digest.String(), nil); err != nil {
+			return ocispec.Descriptor{}, err
+		}
+	}
+	return a.Applier.Apply(ctx, desc, mounts, opts...)
+}
diff --git a/vendor/github.com/moby/buildkit/exporter/containerimage/lazyapply_test.go b/vendor/github.com/moby/buildkit/exporter/containerimage/lazyapply_test.go
