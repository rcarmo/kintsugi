index 0000000..ee0620d
--- /dev/null
+++ b/vendor/github.com/moby/buildkit/snapshot/mountmanager.go
@@ -0,0 +1,118 @@
+package snapshot
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/leases"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/core/snapshots"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	"github.com/moby/buildkit/identity"
+	"github.com/moby/buildkit/util/leaseutil"
+	"github.com/moby/sys/user"
+)
+
+// WithMountManager resolves containerd mount instructions at the Mountable
+// boundary, so executors, local mounters, and exporters receive system mounts.
+func WithMountManager(s Snapshotter, manager mount.Manager, lm leases.Manager, namespace string) Snapshotter {
+	return &managedSnapshotter{Snapshotter: s, manager: manager, leases: lm, namespace: namespace}
+}
+
+type managedSnapshotter struct {
+	Snapshotter
+	manager   mount.Manager
+	leases    leases.Manager
+	namespace string
+}
+
+func (s *managedSnapshotter) Mounts(ctx context.Context, key string) (Mountable, error) {
+	m, err := s.Snapshotter.Mounts(ctx, key)
+	if err != nil {
+		return nil, err
+	}
+	return s.wrap(ctx, key, m), nil
+}
+
+func (s *managedSnapshotter) View(ctx context.Context, key, parent string, opts ...snapshots.Opt) (Mountable, error) {
+	m, err := s.Snapshotter.View(ctx, key, parent, opts...)
+	if err != nil {
+		return nil, err
+	}
+	return s.wrap(ctx, key, m), nil
+}
+
+func (s *managedSnapshotter) wrap(ctx context.Context, key string, m Mountable) Mountable {
+	return &managedMountable{Mountable: m, ctx: namespaces.WithNamespace(context.WithoutCancel(ctx), s.namespace), manager: s.manager, leases: s.leases, key: key}
+}
+
+type managedMountable struct {
+	Mountable
+	ctx     context.Context
+	manager mount.Manager
+	leases  leases.Manager
+	key     string
+}
+
+func (m *managedMountable) IdentityMapping() *user.IdentityMapping {
+	return m.Mountable.IdentityMapping()
+}
+
+func (m *managedMountable) Mount() ([]mount.Mount, func() error, error) {
+	raw, release, err := m.Mountable.Mount()
+	if err != nil {
+		return nil, nil, err
+	}
+	releaseRaw := func() error {
+		if release != nil {
+			return release()
+		}
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(m.ctx), 10*time.Second)
+	defer cancel()
+	// Mountables are cached across operations. Never reuse their lookup lease:
+	// it may have expired or been deleted. No expiration can bound actual use;
+	// release deletes this lease, and worker startup reaps temporary orphans.
+	// Do not use leaseutil.WithLease (reuses the context's lease) or NewLease
+	// (adds a one-hour expiration).
+	lease, err := m.leases.Create(ctx, leases.WithRandomID(), leaseutil.MakeTemporary)
+	if err != nil {
+		return nil, nil, errors.Join(fmt.Errorf("lease buildkit snapshot %s: %w", m.key, err), releaseRaw())
+	}
+	deleteLease := func() error {
+		ctx, cancel := context.WithTimeout(context.WithoutCancel(m.ctx), 10*time.Second)
+		defer cancel()
+		return m.leases.Delete(ctx, lease)
+	}
+	name := "buildkit-" + identity.NewID()
+	// The activation lease is the owner. A snapshot back-reference would keep
+	// orphan activations alive after worker startup removes temporary leases.
+	active, err := m.manager.Activate(leases.WithLease(ctx, lease.ID), name, raw)
+	if errdefs.IsNotImplemented(err) {
+		// Every mount is already a system mount; no activation needs protection.
+		if err := deleteLease(); err != nil {
+			return nil, nil, errors.Join(err, releaseRaw())
+		}
+		return raw, release, nil
+	}
+	if err != nil {
+		return nil, nil, errors.Join(fmt.Errorf("activate buildkit snapshot %s: %w", m.key, err), deleteLease(), releaseRaw())
+	}
+	var once sync.Once
+	var releaseErr error
+	return setRedirectDir(active.System, getRedirectDirOption()), func() error {
+		once.Do(func() {
+			// Keep the lease through deactivation, even after build cancellation.
+			ctx, cancel := context.WithTimeout(context.WithoutCancel(m.ctx), 10*time.Second)
+			defer cancel()
+			releaseErr = m.manager.Deactivate(ctx, name)
+			releaseErr = errors.Join(releaseErr, deleteLease(), releaseRaw())
+		})
+		return releaseErr
+	}, nil
+}
diff --git a/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go b/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go
new file mode 100644
index 0000000..b802a07
--- /dev/null
+++ b/vendor/github.com/moby/buildkit/snapshot/mountmanager_test.go
@@ -0,0 +1,254 @@
+package snapshot
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/leases"
+	"github.com/containerd/containerd/v2/core/mount"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	"github.com/moby/sys/user"
+)
+
+type testMountable struct{ releases int }
+
+func (m *testMountable) Mount() ([]mount.Mount, func() error, error) {
+	return []mount.Mount{{Type: "format/mkdir/overlay", Source: "overlay", Options: []string{"lowerdir={{ overlay 0 2 }}"}}}, func() error { m.releases++; return nil }, nil
+}
+func (*testMountable) IdentityMapping() *user.IdentityMapping { return nil }
+
+type testMountLeases struct {
+	leases.Manager
+	t                    *testing.T
+	live                 map[string]bool
+	creates, deletes     int
+	createErr, deleteErr error
+}
+
+func (l *testMountLeases) checkContext(ctx context.Context) {
+	l.t.Helper()
+	ns, _ := namespaces.Namespace(ctx)
+	if ctx.Err() != nil || ns != "moby" {
+		l.t.Fatalf("invalid lease context: namespace=%q error=%v", ns, ctx.Err())
+	}
+}
+func (l *testMountLeases) Create(ctx context.Context, opts ...leases.Opt) (leases.Lease, error) {
+	l.checkContext(ctx)
+	if l.createErr != nil {
+		return leases.Lease{}, l.createErr
+	}
+	var lease leases.Lease
+	for _, opt := range opts {
+		if err := opt(&lease); err != nil {
+			return leases.Lease{}, err
+		}
+	}
+	if lease.ID == "" || lease.ID == "old-lookup-lease" || l.live[lease.ID] {
+		l.t.Fatal("activation requires a fresh lease")
+	}
+	if _, ok := lease.Labels["containerd.io/gc.expire"]; ok {
+		l.t.Fatal("activation lease must not expire while in use")
+	}
+	if _, ok := lease.Labels["buildkit/lease.temporary"]; !ok {
+		l.t.Fatal("worker restart must reclaim orphan leases")
+	}
+	l.live[lease.ID] = true
+	l.creates++
+	return lease, nil
+}
+func (l *testMountLeases) Delete(ctx context.Context, lease leases.Lease, _ ...leases.DeleteOpt) error {
+	l.checkContext(ctx)
+	if !l.live[lease.ID] {
+		l.t.Fatal("deleted lease more than once")
+	}
+	l.deletes++
+	if l.deleteErr != nil {
+		return l.deleteErr
+	}
+	delete(l.live, lease.ID)
+	return nil
+}
+
+type testMountManager struct {
+	mount.Manager
+	t                      *testing.T
+	leases                 *testMountLeases
+	activates, deactivates int
+	fail, deactivateErr    error
+	keys                   map[string]string
+}
+
+func (m *testMountManager) Activate(ctx context.Context, key string, raw []mount.Mount, opts ...mount.ActivateOpt) (mount.ActivationInfo, error) {
+	m.leases.checkContext(ctx)
+	m.activates++
+	lid, _ := leases.FromContext(ctx)
+	if !m.leases.live[lid] {
+		m.t.Fatal("activation is not protected by a live lease")
+	}
+	if raw[0].Type != "format/mkdir/overlay" {
+		m.t.Fatal("missing raw mount")
+	}
+	if _, ok := m.keys[key]; ok {
+		m.t.Fatal("activation names must be distinct")
+	}
+	m.keys[key] = lid
+	var cfg mount.ActivateOptions
+	for _, opt := range opts {
+		opt(&cfg)
+	}
+	if cfg.Temporary {
+		m.t.Fatal("must not request temporary activation")
+	}
+	if len(cfg.Labels) != 0 {
+		m.t.Fatal("activation lifetime must not be tied to cached snapshots")
+	}
+	return mount.ActivationInfo{System: []mount.Mount{{Type: "bind", Source: "/resolved", Options: []string{"rbind"}}}}, m.fail
+}
+func (m *testMountManager) Deactivate(ctx context.Context, key string) error {
+	m.leases.checkContext(ctx)
+	m.deactivates++
+	if !m.leases.live[m.keys[key]] {
+		m.t.Fatal("lease released before deactivation")
+	}
+	return m.deactivateErr
+}
+
+func newManagedMountTest(t *testing.T) (*managedMountable, *testMountable, *testMountManager, *testMountLeases, context.CancelFunc) {
+	ctx, cancel := context.WithCancel(leases.WithLease(namespaces.WithNamespace(context.Background(), "moby"), "old-lookup-lease"))
+	lm := &testMountLeases{t: t, live: map[string]bool{}}
+	mm := &testMountManager{t: t, leases: lm, keys: map[string]string{}}
+	raw := &testMountable{}
+	m := &managedMountable{Mountable: raw, ctx: ctx, manager: mm, leases: lm, key: "snapshot-key"}
+	t.Cleanup(cancel)
+	return m, raw, mm, lm, cancel
+}
+
+func TestManagedMountLifetime(t *testing.T) {
+	m, raw, mm, lm, cancel := newManagedMountTest(t)
+	mounts, release, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(mounts) != 1 || mounts[0].Type != "bind" || mounts[0].Source != "/resolved" {
+		t.Fatal(mounts)
+	}
+	_, release2, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(lm.live) != 2 {
+		t.Fatal("overlapping consumers need separate leases")
+	}
+	cancel()
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if len(lm.live) != 1 {
+		t.Fatal("release affected another consumer")
+	}
+	if err := release2(); err != nil {
+		t.Fatal(err)
+	}
+	if mm.activates != 2 || mm.deactivates != 2 || raw.releases != 2 || lm.creates != 2 || lm.deletes != 2 || len(lm.live) != 0 {
+		t.Fatal("incorrect activation/lease lifetime counts")
+	}
+}
+
+func TestManagedMountActivationFailure(t *testing.T) {
+	m, raw, mm, lm, _ := newManagedMountTest(t)
+	fail := errors.New("activation failed")
+	mm.fail = fail
+	mounts, release, err := m.Mount()
+	if !errors.Is(err, fail) || mounts != nil || release != nil {
+		t.Fatalf("unexpected result: %v %v", mounts, err)
+	}
+	if raw.releases != 1 || mm.deactivates != 0 || lm.deletes != 1 || len(lm.live) != 0 {
+		t.Fatal("incorrect failed activation cleanup")
+	}
+}
+
+func TestManagedMountSystemMounts(t *testing.T) {
+	m, raw, mm, lm, _ := newManagedMountTest(t)
+	mm.fail = errdefs.ErrNotImplemented
+	mounts, release, err := m.Mount()
+	if err != nil || len(mounts) != 1 {
+		t.Fatalf("%v %v", mounts, err)
+	}
+	if len(lm.live) != 0 || lm.deletes != 1 {
+		t.Fatal("system-only mounts leaked a lease")
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+	if raw.releases != 1 || mm.deactivates != 0 {
+		t.Fatal("system mount cleanup")
+	}
+}
+
+func TestManagedMountAfterLookupCancellation(t *testing.T) {
+	m, _, _, _, cancel := newManagedMountTest(t)
+	cancel()
+	_, release, err := m.Mount()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := release(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestManagedMountLeaseCreationFailure(t *testing.T) {
+	m, raw, mm, lm, _ := newManagedMountTest(t)
+	lm.createErr = errors.New("lease creation failed")
+	mounts, release, err := m.Mount()
+	if !errors.Is(err, lm.createErr) || mounts != nil || release != nil {
+		t.Fatalf("unexpected result: %v %v", mounts, err)
+	}
+	if raw.releases != 1 || mm.activates != 0 || lm.deletes != 0 {
+		t.Fatal("incorrect failed lease cleanup")
+	}
+}
+
+func TestManagedMountCleanupErrors(t *testing.T) {
+	for _, activationErr := range []error{nil, errors.New("activation failed"), errdefs.ErrNotImplemented} {
+		t.Run(fmtError(activationErr), func(t *testing.T) {
+			m, raw, mm, lm, _ := newManagedMountTest(t)
+			mm.fail = activationErr
+			lm.deleteErr = errors.New("delete lease failed")
+			_, release, err := m.Mount()
+			if activationErr == nil {
+				if err != nil {
+					t.Fatal(err)
+				}
+				mm.deactivateErr = errors.New("deactivate failed")
+				err = release()
+				if !errors.Is(err, mm.deactivateErr) {
+					t.Fatal("lost deactivation error")
+				}
+				if err2 := release(); err2 != err {
+					t.Fatal("cleanup must be idempotent")
+				}
+			} else if !errors.Is(activationErr, errdefs.ErrNotImplemented) && !errors.Is(err, activationErr) {
+				t.Fatal("lost activation error")
+			}
+			if !errors.Is(err, lm.deleteErr) {
+				t.Fatal("lost lease deletion error")
+			}
+			if raw.releases != 1 || lm.deletes != 1 {
+				t.Fatal("cleanup must attempt all resources exactly once")
+			}
+		})
+	}
+}
+
+func fmtError(err error) string {
+	if err == nil {
+		return "release"
+	}
+	return err.Error()
+}
