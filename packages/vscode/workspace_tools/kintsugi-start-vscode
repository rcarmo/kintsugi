#!/bin/sh
set -eu

server_data_dir="/.kintsugi/vscode/server-data"
defaults_dir="/opt/kintsugi/vscode-defaults"
extensions_dir="/opt/kintsugi/vscode-extensions"

seed_file() {
  src="$1"
  dst="$2"
  if [ -f "$src" ] && [ ! -e "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
  fi
}

# Seed remote/server-side VS Code defaults. Browser-local User settings are not
# controlled by code serve-web.
seed_file "$defaults_dir/Machine/settings.json" "$server_data_dir/data/Machine/settings.json"
seed_file "$defaults_dir/Machine/mcp.json" "$server_data_dir/data/Machine/mcp.json"

set -- \
  --accept-server-license-terms \
  --host "${KINTSUGI_VSCODE_HOST:-${ATELIER_VSCODE_HOST:-0.0.0.0}}" \
  --port "${KINTSUGI_VSCODE_PORT:-${ATELIER_VSCODE_PORT:-24800}}" \
  --without-connection-token \
  --server-data-dir "$server_data_dir"

workspace="${KINTSUGI_VSCODE_DEFAULT_WORKSPACE:-${ATELIER_VSCODE_DEFAULT_WORKSPACE:-}}"
if [ -n "$workspace" ]; then
  set -- "$@" --default-workspace "$workspace"
else
  set -- "$@" --default-folder "/work"
fi

exec /opt/kintsugi/vscode-server/bin/code-server "$@" --extensions-dir "$extensions_dir"
