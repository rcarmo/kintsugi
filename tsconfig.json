{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@kintsugi/core": ["./packages/core/src/index.ts"],
      "@kintsugi/shared": ["./packages/shared/src/index.ts"],
      "@kintsugi/browser/server": ["./packages/browser/src/server/index.ts"],
      "@kintsugi/browser/client": ["./packages/browser/src/client/index.ts"],
      "@kintsugi/browser": ["./packages/browser/src/server/index.ts"],
      "@kintsugi/subagents/server": ["./packages/subagents/src/server/index.ts"],
      "@kintsugi/subagents/client": ["./packages/subagents/src/client/index.ts"],
      "@kintsugi/builtin-agent/server": ["./packages/builtin-agent/src/server/index.ts"],
      "@kintsugi/builtin-agent": ["./packages/builtin-agent/src/server/index.ts"],
      "@kintsugi/agent/server": ["./packages/agent/src/server/index.ts"],
      "@kintsugi/agent/client": ["./packages/agent/src/client/index.ts"],
      "@kintsugi/agent": ["./packages/agent/src/server/index.ts"],
      "@kintsugi/workspace/git": ["./packages/workspace/src/git.ts"],
      "@kintsugi/workspace": ["./packages/workspace/src/index.ts"],
      "@kintsugi/workspace/client": ["./packages/workspace/src/client/index.ts"],
      "@kintsugi/workspace/server/provisioning": ["./packages/workspace/src/server/provisioning-web.ts"],
      "@kintsugi/workspace-templates": ["./packages/workspace-templates/src/index.ts"],
      "@kintsugi/workspace-templates/server": ["./packages/workspace-templates/src/server/index.ts"],
      "@kintsugi/workspace-image": ["./packages/workspace-image/src/index.ts"],
      "@kintsugi/proxy-egress/server": ["./packages/proxy-egress/src/server/index.ts"],
      "@kintsugi/proxy-egress": ["./packages/proxy-egress/src/server/index.ts"],
      "@kintsugi/proxy-ingress/server": ["./packages/proxy-ingress/src/server/index.ts"],
      "@kintsugi/proxy-ingress": ["./packages/proxy-ingress/src/server/index.ts"],
      "@kintsugi/update/server": ["./packages/update/src/server/index.ts"],
      "@kintsugi/update/client": ["./packages/update/src/client/index.ts"],
      "@kintsugi/dictation": ["./packages/dictation/src/server/index.ts"],
      "@kintsugi/dictation/server": ["./packages/dictation/src/server/index.ts"],
      "@kintsugi/dictation/client": ["./packages/dictation/src/client/index.ts"],
      "@kintsugi/update": ["./packages/update/src/server/index.ts"],
      "@kintsugi/observable-terminal/server": ["./packages/observable-terminal/src/server/index.ts"],
      "@kintsugi/observable-terminal/client": ["./packages/observable-terminal/src/client/index.ts"],
      "@kintsugi/observable-terminal/shared": ["./packages/observable-terminal/src/shared/index.ts"],
      "@kintsugi/observable-terminal": ["./packages/observable-terminal/src/server/index.ts"],
      "@kintsugi/workspace-terminal/server": ["./packages/workspace-terminal/src/server/index.ts"],
      "@kintsugi/workspace-terminal/client": ["./packages/workspace-terminal/src/client/index.ts"],
      "@kintsugi/workspace-terminal": ["./packages/workspace-terminal/src/server/index.ts"],
      "@kintsugi/vscode/server": ["./packages/vscode/src/server/index.ts"],
      "@kintsugi/vscode/client": ["./packages/vscode/src/client/index.ts"],
      "@kintsugi/vscode": ["./packages/vscode/src/server/index.ts"]
    },
    "types": ["bun-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tools/ios-serve-sim/**/*.ts"
  ]
}
